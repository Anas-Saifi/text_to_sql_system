
{
  "database": "siemens_energy",
  "dialect": "PostgreSQL",
  "tables": {
    "departments": {
      "columns": {
        "department_id": "INTEGER",
        "department_name": "VARCHAR(100)",
        "division": "VARCHAR(100)",
        "location": "VARCHAR(150)",
        "budget": "DECIMAL(15,2)",
        "head_employee_id": "INTEGER"
      },
      "primary_key": ["department_id"],
      "foreign_keys": {
        "head_employee_id": "employees.employee_id"
      }
    },
    "employees": {
      "columns": {
        "employee_id": "INTEGER",
        "first_name": "VARCHAR(100)",
        "last_name": "VARCHAR(100)",
        "email": "VARCHAR(150)",
        "job_title": "VARCHAR(150)",
        "department_id": "INTEGER",
        "manager_id": "INTEGER",
        "hire_date": "DATE",
        "salary": "DECIMAL(12,2)",
        "country": "VARCHAR(100)",
        "employment_status": "VARCHAR(30)"
      },
      "primary_key": ["employee_id"],
      "foreign_keys": {
        "department_id": "departments.department_id",
        "manager_id": "employees.employee_id"
      }
    },
    "employee_skills": {
      "columns": {
        "skill_id": "INTEGER",
        "employee_id": "INTEGER",
        "skill_name": "VARCHAR(100)",
        "proficiency_level": "VARCHAR(50)",
        "certification_date": "DATE"
      },
      "primary_key": ["skill_id"],
      "foreign_keys": {
        "employee_id": "employees.employee_id"
      }
    },
    "facilities": {
      "columns": {
        "facility_id": "INTEGER",
        "facility_name": "VARCHAR(200)",
        "facility_type": "VARCHAR(100)",
        "country": "VARCHAR(100)",
        "city": "VARCHAR(100)",
        "address": "TEXT",
        "operational_status": "VARCHAR(50)"
      },
      "primary_key": ["facility_id"],
      "foreign_keys": {}
    },
    "customers": {
      "columns": {
        "customer_id": "INTEGER",
        "company_name": "VARCHAR(200)",
        "industry": "VARCHAR(100)",
        "customer_type": "VARCHAR(50)",
        "country": "VARCHAR(100)",
        "city": "VARCHAR(100)",
        "contact_person": "VARCHAR(150)",
        "email": "VARCHAR(150)",
        "annual_revenue": "DECIMAL(18,2)"
      },
      "primary_key": ["customer_id"],
      "foreign_keys": {}
    },
    "customer_contacts": {
      "columns": {
        "contact_id": "INTEGER",
        "customer_id": "INTEGER",
        "contact_name": "VARCHAR(150)",
        "designation": "VARCHAR(100)",
        "email": "VARCHAR(150)",
        "phone": "VARCHAR(30)"
      },
      "primary_key": ["contact_id"],
      "foreign_keys": {
        "customer_id": "customers.customer_id"
      }
    },
    "suppliers": {
      "columns": {
        "supplier_id": "INTEGER",
        "supplier_name": "VARCHAR(200)",
        "supplier_category": "VARCHAR(100)",
        "country": "VARCHAR(100)",
        "city": "VARCHAR(100)",
        "contact_email": "VARCHAR(150)",
        "supplier_rating": "DECIMAL(3,2)",
        "status": "VARCHAR(30)"
      },
      "primary_key": ["supplier_id"],
      "foreign_keys": {}
    },
    "supplier_contracts": {
      "columns": {
        "contract_id": "INTEGER",
        "supplier_id": "INTEGER",
        "contract_number": "VARCHAR(100)",
        "start_date": "DATE",
        "end_date": "DATE",
        "contract_value": "DECIMAL(18,2)",
        "status": "VARCHAR(30)"
      },
      "primary_key": ["contract_id"],
      "foreign_keys": {
        "supplier_id": "suppliers.supplier_id"
      }
    },
    "products": {
      "columns": {
        "product_id": "INTEGER",
        "product_name": "VARCHAR(200)",
        "product_category": "VARCHAR(100)",
        "technology": "VARCHAR(100)",
        "model_number": "VARCHAR(100)",
        "rated_capacity_mw": "DECIMAL(12,2)",
        "unit_price": "DECIMAL(15,2)"
      },
      "primary_key": ["product_id"],
      "foreign_keys": {}
    },
    "product_components": {
      "columns": {
        "component_id": "INTEGER",
        "product_id": "INTEGER",
        "component_name": "VARCHAR(200)",
        "component_type": "VARCHAR(100)",
        "manufacturer": "VARCHAR(150)",
        "specification": "TEXT"
      },
      "primary_key": ["component_id"],
      "foreign_keys": {
        "product_id": "products.product_id"
      }
    },
    "manufacturing_plants": {
      "columns": {
        "plant_id": "INTEGER",
        "plant_name": "VARCHAR(200)",
        "country": "VARCHAR(100)",
        "city": "VARCHAR(100)",
        "facility_id": "INTEGER",
        "production_capacity": "DECIMAL(15,2)",
        "operational_status": "VARCHAR(50)"
      },
      "primary_key": ["plant_id"],
      "foreign_keys": {
        "facility_id": "facilities.facility_id"
      }
    },
    "production_orders": {
      "columns": {
        "order_id": "INTEGER",
        "product_id": "INTEGER",
        "plant_id": "INTEGER",
        "quantity": "INTEGER",
        "order_date": "DATE",
        "completion_date": "DATE",
        "production_status": "VARCHAR(50)"
      },
      "primary_key": ["order_id"],
      "foreign_keys": {
        "product_id": "products.product_id",
        "plant_id": "manufacturing_plants.plant_id"
      }
    },
    "quality_inspections": {
      "columns": {
        "inspection_id": "INTEGER",
        "order_id": "INTEGER",
        "inspector_id": "INTEGER",
        "inspection_date": "DATE",
        "quality_score": "DECIMAL(5,2)",
        "defect_count": "INTEGER",
        "inspection_status": "VARCHAR(50)"
      },
      "primary_key": ["inspection_id"],
      "foreign_keys": {
        "order_id": "production_orders.order_id",
        "inspector_id": "employees.employee_id"
      }
    },
    "assets": {
      "columns": {
        "asset_id": "INTEGER",
        "product_id": "INTEGER",
        "customer_id": "INTEGER",
        "facility_id": "INTEGER",
        "serial_number": "VARCHAR(100)",
        "installation_date": "DATE",
        "warranty_expiry": "DATE",
        "operational_status": "VARCHAR(50)"
      },
      "primary_key": ["asset_id"],
      "foreign_keys": {
        "product_id": "products.product_id",
        "customer_id": "customers.customer_id",
        "facility_id": "facilities.facility_id"
      }
    },
    "power_plants": {
      "columns": {
        "power_plant_id": "INTEGER",
        "customer_id": "INTEGER",
        "plant_name": "VARCHAR(200)",
        "plant_type": "VARCHAR(100)",
        "country": "VARCHAR(100)",
        "capacity_mw": "DECIMAL(12,2)",
        "commissioning_date": "DATE",
        "operational_status": "VARCHAR(50)"
      },
      "primary_key": ["power_plant_id"],
      "foreign_keys": {
        "customer_id": "customers.customer_id"
      }
    },
    "turbines": {
      "columns": {
        "turbine_id": "INTEGER",
        "asset_id": "INTEGER",
        "turbine_type": "VARCHAR(100)",
        "model": "VARCHAR(100)",
        "rated_output_mw": "DECIMAL(12,2)",
        "manufacturer": "VARCHAR(150)",
        "operating_hours": "DECIMAL(15,2)"
      },
      "primary_key": ["turbine_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id"
      }
    },
    "generators": {
      "columns": {
        "generator_id": "INTEGER",
        "asset_id": "INTEGER",
        "generator_type": "VARCHAR(100)",
        "rated_capacity_mw": "DECIMAL(12,2)",
        "voltage_rating": "VARCHAR(50)",
        "efficiency": "DECIMAL(5,2)"
      },
      "primary_key": ["generator_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id"
      }
    },
    "transformers": {
      "columns": {
        "transformer_id": "INTEGER",
        "asset_id": "INTEGER",
        "transformer_type": "VARCHAR(100)",
        "voltage_level": "VARCHAR(50)",
        "rated_capacity_mva": "DECIMAL(12,2)",
        "installation_date": "DATE"
      },
      "primary_key": ["transformer_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id"
      }
    },
    "projects": {
      "columns": {
        "project_id": "INTEGER",
        "project_name": "VARCHAR(200)",
        "customer_id": "INTEGER",
        "project_manager_id": "INTEGER",
        "project_type": "VARCHAR(100)",
        "start_date": "DATE",
        "expected_end_date": "DATE",
        "actual_end_date": "DATE",
        "project_budget": "DECIMAL(18,2)",
        "actual_cost": "DECIMAL(18,2)",
        "project_status": "VARCHAR(50)"
      },
      "primary_key": ["project_id"],
      "foreign_keys": {
        "customer_id": "customers.customer_id",
        "project_manager_id": "employees.employee_id"
      }
    },
    "project_milestones": {
      "columns": {
        "milestone_id": "INTEGER",
        "project_id": "INTEGER",
        "milestone_name": "VARCHAR(200)",
        "planned_date": "DATE",
        "actual_date": "DATE",
        "status": "VARCHAR(50)"
      },
      "primary_key": ["milestone_id"],
      "foreign_keys": {
        "project_id": "projects.project_id"
      }
    },
    "project_resources": {
      "columns": {
        "resource_id": "INTEGER",
        "project_id": "INTEGER",
        "employee_id": "INTEGER",
        "allocation_percentage": "DECIMAL(5,2)",
        "start_date": "DATE",
        "end_date": "DATE"
      },
      "primary_key": ["resource_id"],
      "foreign_keys": {
        "project_id": "projects.project_id",
        "employee_id": "employees.employee_id"
      }
    },
    "work_orders": {
      "columns": {
        "work_order_id": "INTEGER",
        "asset_id": "INTEGER",
        "assigned_employee_id": "INTEGER",
        "project_id": "INTEGER",
        "work_order_type": "VARCHAR(100)",
        "priority": "VARCHAR(30)",
        "description": "TEXT",
        "scheduled_date": "DATE",
        "completion_date": "DATE",
        "maintenance_cost": "DECIMAL(15,2)",
        "status": "VARCHAR(50)"
      },
      "primary_key": ["work_order_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id",
        "assigned_employee_id": "employees.employee_id",
        "project_id": "projects.project_id"
      }
    },
    "maintenance_schedules": {
      "columns": {
        "schedule_id": "INTEGER",
        "asset_id": "INTEGER",
        "maintenance_type": "VARCHAR(100)",
        "frequency_days": "INTEGER",
        "next_maintenance_date": "DATE",
        "last_maintenance_date": "DATE"
      },
      "primary_key": ["schedule_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id"
      }
    },
    "sensor_readings": {
      "columns": {
        "reading_id": "INTEGER",
        "asset_id": "INTEGER",
        "sensor_type": "VARCHAR(100)",
        "reading_value": "DECIMAL(15,4)",
        "unit": "VARCHAR(30)",
        "reading_timestamp": "TIMESTAMP"
      },
      "primary_key": ["reading_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id"
      }
    },
    "inspections": {
      "columns": {
        "inspection_id": "INTEGER",
        "asset_id": "INTEGER",
        "inspector_id": "INTEGER",
        "inspection_date": "DATE",
        "temperature": "DECIMAL(8,2)",
        "vibration_level": "DECIMAL(8,3)",
        "efficiency_percentage": "DECIMAL(5,2)",
        "findings": "TEXT",
        "risk_level": "VARCHAR(30)"
      },
      "primary_key": ["inspection_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id",
        "inspector_id": "employees.employee_id"
      }
    },
    "failure_events": {
      "columns": {
        "failure_id": "INTEGER",
        "asset_id": "INTEGER",
        "failure_type": "VARCHAR(100)",
        "failure_date": "TIMESTAMP",
        "severity": "VARCHAR(30)",
        "downtime_hours": "DECIMAL(10,2)",
        "root_cause": "TEXT",
        "resolution_status": "VARCHAR(50)"
      },
      "primary_key": ["failure_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id"
      }
    },
    "maintenance_history": {
      "columns": {
        "history_id": "INTEGER",
        "asset_id": "INTEGER",
        "work_order_id": "INTEGER",
        "maintenance_date": "DATE",
        "maintenance_action": "TEXT",
        "labor_hours": "DECIMAL(10,2)",
        "total_cost": "DECIMAL(15,2)"
      },
      "primary_key": ["history_id"],
      "foreign_keys": {
        "asset_id": "assets.asset_id",
        "work_order_id": "work_orders.work_order_id"
      }
    },
    "parts": {
      "columns": {
        "part_id": "INTEGER",
        "part_name": "VARCHAR(200)",
        "part_number": "VARCHAR(100)",
        "category": "VARCHAR(100)",
        "supplier_id": "INTEGER",
        "unit_cost": "DECIMAL(12,2)"
      },
      "primary_key": ["part_id"],
      "foreign_keys": {
        "supplier_id": "suppliers.supplier_id"
      }
    },
    "inventory": {
      "columns": {
        "inventory_id": "INTEGER",
        "part_id": "INTEGER",
        "facility_id": "INTEGER",
        "quantity_available": "INTEGER",
        "reorder_level": "INTEGER",
        "last_restocked": "DATE"
      },
      "primary_key": ["inventory_id"],
      "foreign_keys": {
        "part_id": "parts.part_id",
        "facility_id": "facilities.facility_id"
      },
      "unique_constraints": [
        ["part_id", "facility_id"]
      ]
    },
    "purchase_orders": {
      "columns": {
        "purchase_order_id": "INTEGER",
        "supplier_id": "INTEGER",
        "order_date": "DATE",
        "expected_delivery_date": "DATE",
        "total_amount": "DECIMAL(18,2)",
        "order_status": "VARCHAR(50)"
      },
      "primary_key": ["purchase_order_id"],
      "foreign_keys": {
        "supplier_id": "suppliers.supplier_id"
      }
    },
    "purchase_order_items": {
      "columns": {
        "item_id": "INTEGER",
        "purchase_order_id": "INTEGER",
        "part_id": "INTEGER",
        "quantity": "INTEGER",
        "unit_price": "DECIMAL(12,2)",
        "subtotal": "DECIMAL(15,2)"
      },
      "primary_key": ["item_id"],
      "foreign_keys": {
        "purchase_order_id": "purchase_orders.purchase_order_id",
        "part_id": "parts.part_id"
      }
    },
    "shipments": {
      "columns": {
        "shipment_id": "INTEGER",
        "purchase_order_id": "INTEGER",
        "shipment_date": "DATE",
        "expected_arrival": "DATE",
        "actual_arrival": "DATE",
        "shipment_status": "VARCHAR(50)"
      },
      "primary_key": ["shipment_id"],
      "foreign_keys": {
        "purchase_order_id": "purchase_orders.purchase_order_id"
      }
    },
    "generation_records": {
      "columns": {
        "record_id": "INTEGER",
        "power_plant_id": "INTEGER",
        "asset_id": "INTEGER",
        "generation_date": "DATE",
        "energy_generated_mwh": "DECIMAL(15,2)",
        "operating_hours": "DECIMAL(10,2)"
      },
      "primary_key": ["record_id"],
      "foreign_keys": {
        "power_plant_id": "power_plants.power_plant_id",
        "asset_id": "assets.asset_id"
      }
    },
    "energy_consumption": {
      "columns": {
        "consumption_id": "INTEGER",
        "power_plant_id": "INTEGER",
        "reporting_date": "DATE",
        "energy_consumed_mwh": "DECIMAL(15,2)"
      },
      "primary_key": ["consumption_id"],
      "foreign_keys": {
        "power_plant_id": "power_plants.power_plant_id"
      }
    },
    "turbine_performance": {
      "columns": {
        "performance_id": "INTEGER",
        "turbine_id": "INTEGER",
        "recorded_at": "TIMESTAMP",
        "output_mw": "DECIMAL(12,2)",
        "efficiency_percentage": "DECIMAL(5,2)",
        "fuel_consumption": "DECIMAL(15,2)",
        "temperature": "DECIMAL(8,2)"
      },
      "primary_key": ["performance_id"],
      "foreign_keys": {
        "turbine_id": "turbines.turbine_id"
      }
    },
    "emissions_records": {
      "columns": {
        "emission_id": "INTEGER",
        "power_plant_id": "INTEGER",
        "reporting_date": "DATE",
        "co2_emissions": "DECIMAL(15,2)",
        "nox_emissions": "DECIMAL(15,2)",
        "sox_emissions": "DECIMAL(15,2)"
      },
      "primary_key": ["emission_id"],
      "foreign_keys": {
        "power_plant_id": "power_plants.power_plant_id"
      }
    },
    "invoices": {
      "columns": {
        "invoice_id": "INTEGER",
        "customer_id": "INTEGER",
        "project_id": "INTEGER",
        "invoice_date": "DATE",
        "due_date": "DATE",
        "total_amount": "DECIMAL(18,2)",
        "payment_status": "VARCHAR(50)"
      },
      "primary_key": ["invoice_id"],
      "foreign_keys": {
        "customer_id": "customers.customer_id",
        "project_id": "projects.project_id"
      }
    },
    "payments": {
      "columns": {
        "payment_id": "INTEGER",
        "invoice_id": "INTEGER",
        "payment_date": "DATE",
        "amount_paid": "DECIMAL(18,2)",
        "payment_method": "VARCHAR(50)",
        "transaction_reference": "VARCHAR(150)"
      },
      "primary_key": ["payment_id"],
      "foreign_keys": {
        "invoice_id": "invoices.invoice_id"
      }
    },
    "expenses": {
      "columns": {
        "expense_id": "INTEGER",
        "project_id": "INTEGER",
        "department_id": "INTEGER",
        "expense_category": "VARCHAR(100)",
        "amount": "DECIMAL(15,2)",
        "expense_date": "DATE"
      },
      "primary_key": ["expense_id"],
      "foreign_keys": {
        "project_id": "projects.project_id",
        "department_id": "departments.department_id"
      }
    },
    "budgets": {
      "columns": {
        "budget_id": "INTEGER",
        "department_id": "INTEGER",
        "fiscal_year": "INTEGER",
        "allocated_amount": "DECIMAL(18,2)",
        "actual_spending": "DECIMAL(18,2)"
      },
      "primary_key": ["budget_id"],
      "foreign_keys": {
        "department_id": "departments.department_id"
      }
    }
  }
}
